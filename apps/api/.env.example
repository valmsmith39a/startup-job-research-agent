# Bearer token required on every path except /health. Generate one with: openssl rand -hex 32
# Not the same secret as the MCP server's MCP_API_KEY.
API_KEY=
# true turns auth off. Local testing only: refused unless HOST is 127.0.0.1, localhost or ::1.
AUTH_DISABLED=false
# Bind address/port. The MCP server uses 8000, so apps/api defaults to 8001.
HOST=127.0.0.1
PORT=8001
