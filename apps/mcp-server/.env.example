# Bearer token required on /mcp. Generate one with: openssl rand -hex 32
MCP_API_KEY=
# true turns auth off. Local testing only: refused unless HOST is 127.0.0.1, localhost or ::1.
AUTH_DISABLED=false
# Bind address/port. The Docker image sets HOST=0.0.0.0; Railway injects PORT.
HOST=127.0.0.1
PORT=8000
